# =====================================================================
# Alibhai Points - Root Environment Overview / Reference (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. BACKEND API (apps/api/.env)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19006,http://localhost:3000,*
AUTH_EMAIL_DOMAIN=points.alibhai.co.tz

# ---------------------------------------------------------------------
# 2. MOBILE APP (apps/mobile/.env)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_API_URL=http://localhost:5000
