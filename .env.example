# =====================================================================
# Alibhai Points - Root Environment Overview / Reference (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# 1. BACKEND API (apps/api/.env)
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development
AUTH_EMAIL_DOMAIN=points

SUPABASE_URL=https://your-project-ref.supabase.co
# Secret key (service role) - Keep secret! Only for backend server
# Supports: SUPABASE_SECRET_KEY (preferred), SUPABASE_SERVICE_ROLE_KEY, SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=your-supabase-secret-key-here

CORS_ORIGINS=http://localhost

# ---------------------------------------------------------------------
# 2. MOBILE APP (apps/mobile/.env)
# ---------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon public key (Safe for client/mobile)
# Supports: EXPO_PUBLIC_SUPABASE_ANON_KEY (preferred), EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
EXPO_PUBLIC_API_URL=http://localhost:5000
