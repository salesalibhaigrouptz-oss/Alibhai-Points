# =====================================================================
# Alibhai Points Mobile App (Expo) - Environment Configuration
# =====================================================================

# Public client values only. Never add a service-role key or any other secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Use the LAN address of your development computer on a physical phone.
# Android emulator: http://10.0.2.2:5000
# iOS simulator / web on this computer: http://localhost:5000
# Production builds must use the HTTPS Vercel API URL.
EXPO_PUBLIC_API_URL=http://localhost:5000
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=points.alibhai.co.tz
EXPO_PUBLIC_AUTH_MODE=pin

# Optional HTTPS links; the app hides each link when its value is empty.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=
