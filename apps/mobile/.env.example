# =====================================================================
# Alibhai Points Mobile App (Expo) - Environment Configuration
# =====================================================================

# Supabase Public Configuration (Safe for client applications)
# Only use the anon public key here. NEVER use the service-role key in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API Endpoint
# For Android emulator: http://10.0.2.2:5000
# For iOS simulator / Web: http://localhost:5000
# For physical phone on local Wi-Fi: http://<your-computer-ip>:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Auth Mode: 'pin' | 'whatsapp_otp' (default: 'pin')
EXPO_PUBLIC_AUTH_MODE=pin

# Domain suffix for phone+PIN email generation: 255XXXXXXXXX@<AUTH_EMAIL_DOMAIN>
EXPO_PUBLIC_AUTH_EMAIL_DOMAIN=points.alibhai.co.tz

