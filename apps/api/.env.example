# Alibhai Points API Environment Variables

# Server Configuration
NODE_ENV=development
PORT=5000

# CORS Origins (comma-separated, or * for all)
# In production, specify your frontend domains
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Supabase Configuration
# WARNING: Never expose service_role keys to the frontend!
# The backend uses service_role for database operations.
# The frontend uses anon/authenticated keys for auth only.

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Backend only - never commit to git!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Anon Key (Frontend auth only)
SUPABASE_ANON_KEY=your-anon-key-here

# Time Zone (for expiry job scheduling)
TZ=Africa/Dar_es_Salaam
