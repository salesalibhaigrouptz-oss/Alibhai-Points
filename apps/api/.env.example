# =====================================================================
# Alibhai Points Backend API - Environment Configuration
# =====================================================================

# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Settings (Server Only)
# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the mobile client or commit to Git.
# The backend uses service_role key to bypass RLS and execute database functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# CORS Configuration (comma-separated origins allowed to make requests)
CORS_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19006,http://localhost:3000,*

# Phone + PIN Auth (Temporary)
# The domain suffix used when constructing fake Supabase emails from phone numbers.
# Supabase email format: 255712345678@<AUTH_EMAIL_DOMAIN>
# Example: points.alibhai.co.tz
AUTH_EMAIL_DOMAIN=points.alibhai.co.tz
